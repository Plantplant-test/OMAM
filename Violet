            showToast("已成功複製分享文案！請進行截圖，並貼到 IG 限時動態 @plantplant 以兌換吸水盆折扣 📸");
        }

        // --- 模擬選購跳轉 ---
        function buyPackage() {
            const data = results[selectedResultColor];
            showToast(`正在帶您前往 ${data.healingPlant} 精品套組購買頁面... 🛒`);
        }

        // --- 重新開始 ---
        function restartQuiz() {
            screenResult.classList.add('hidden');
            screenWelcome.classList.remove('hidden');
        }
    </script>
</body>
